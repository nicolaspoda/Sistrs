# Copy this file to .env and fill in the values for your environment.
# See CLAUDE.md for the meaning of EXPO_PUBLIC_ENV (production vs development/staging).

# production | development | staging
EXPO_PUBLIC_ENV=development

# From `supabase start` output when running Supabase locally,
# or from your Supabase project settings when using a hosted project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Copy this file to .env and fill in the values for your environment.
# See CLAUDE.md for the meaning of EXPO_PUBLIC_ENV (production vs development/staging).

# production | development | staging
EXPO_PUBLIC_ENV=development

# From `supabase start` output when running Supabase locally,
# or from your Supabase project settings when using a hosted project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox (carte interactive sur le détail événement) — gratuit jusqu'à un
# gros volume. Crée un compte sur mapbox.com puis :
#  - token PUBLIC ("public scope", commence par pk.) -> ci-dessous
#  - token SECRET avec le scope "Downloads:Read" (commence par sk.) -> à
#    mettre dans ~/.netrc en local (RNMapboxMapsDownloadToken), voir
#    PROGRESS.md pour la procédure complète (nécessaire pour `expo prebuild`)
EXPO_PUBLIC_MAPBOX_TOKEN=

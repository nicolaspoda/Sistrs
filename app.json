{
  "expo": {
    "name": "Sistrs",
    "slug": "sistrs",
    "scheme": "sistrs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Sistrs utilise Face ID pour confirmer ton identité à l'inscription et lors de l'inscription à un événement.",
        "NSPhotoLibraryUsageDescription": "Sistrs a besoin d'accéder à tes photos pour choisir ton avatar ou ta pièce d'identité."
      },
      "bundleIdentifier": "com.nicolaspoda.sistrs"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.nicolaspoda.sistrs"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-local-authentication",
      "expo-image-picker",
      "expo-notifications",
      [
        "@rnmapbox/maps",
        {}
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4022d5a1-8d89-4a63-aa04-a32e49727fb1"
      }
    },
    "owner": "nicolaspoda"
  }
}
